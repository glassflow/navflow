# One hostname fronts both services. Set NAVFLOW_DOMAIN=demo.navflow.dev for automatic HTTPS;
# unset, compose passes ":80" so it serves plain HTTP on :80 (local testing).
{$NAVFLOW_DOMAIN} {
	# the remote MCP endpoint (streamable-http mounts at /mcp) — route it before the catch-all,
	# since navflowd serves the SPA for every other path
	handle /mcp* {
		reverse_proxy mcp:8788
	}
	handle /sse* {
		reverse_proxy mcp:8788
	}
	# console UI + API + ingest
	handle {
		reverse_proxy navflowd:8787
	}
}
